# 이 파일을 서버에서 .env.vps로 복사한 뒤 CHANGE_ME 값을 모두 교체합니다.
# 비밀번호는 URL 인코딩 문제가 없는 영문·숫자 64자리(예: `openssl rand -hex 32`)를 권장합니다.

APP_VERSION=latest

# Sakura VPS가 무료로 제공하는 표준 호스트명입니다. 앞부분은 임의로 변경할 수 없습니다.
PUBLIC_DOMAIN=os3-000-00000.vs.sakura.ne.jp

# 세 주소의 A 레코드는 모두 같은 Sakura VPS 공인 IPv4를 가리켜야 합니다.
AGENT_DOMAIN=staff.example.com
GUEST_DOMAIN=chat.example.com
API_DOMAIN=api.example.com

POSTGRES_DB=hotel_chat
POSTGRES_USER=hotel_chat
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_64_HEX

# 아래 두 키를 잃으면 기존 로그인 토큰 또는 저장된 QR 접근키 복원이 불가능합니다.
JWT_SECRET=CHANGE_ME_JWT_64_HEX
ACCESS_KEY_ENCRYPTION_SECRET=CHANGE_ME_ACCESS_KEY_64_HEX

# 최초 `deploy.sh --bootstrap`에서만 사용하며 이후 일반 배포는 시드를 실행하지 않습니다.
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_AGENT_PASSWORD=CHANGE_ME_AGENT_PASSWORD
SEED_ROOM_ACCESS_KEY=CHANGE_ME_ROOM_1201_64_HEX
SEED_SECOND_ROOM_ACCESS_KEY=CHANGE_ME_ROOM_1202_64_HEX

# VPS 내부 백업은 장애 복구용 1차 사본입니다. 별도 회사 저장소로 추가 복사해야 합니다.
BACKUP_RETENTION_DAYS=14
